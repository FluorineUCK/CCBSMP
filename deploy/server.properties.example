# Template only; not an exported runtime configuration.
# Requires DirectAuth plus pre-migrated premium account UUIDs; do not apply alone.
server-port=44629
online-mode=false
enforce-secure-profile=false
white-list=true
enforce-whitelist=true
enable-command-block=true
spawn-protection=0
# RCON is disabled in the template; configure it privately at deployment.
enable-rcon=false
